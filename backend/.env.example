APP_ENV=local
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app
DB_USER=root
DB_PASSWORD=

# Obligatoire : générer avec `php -r "echo bin2hex(random_bytes(32));"`.
# Le boot échoue si cette valeur est vide ou reste "change-me".
JWT_SECRET=change-me
JWT_COOKIE_NAME=app_token

# Port du serveur de dev Vite (npm run dev dans frontend/) — lu par
# App\Core\Assets pour injecter les bonnes balises <script> en local.
VITE_DEV_PORT=5173
